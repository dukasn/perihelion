# 1. Deny every file everywhere by default
*

# 2. Allow Git to walk directories to discover tracked files
!*/

# Root configuration & dotfiles
!/.gitignore
!/.gitattributes
!/.editorconfig
!/.lefthook.yml
!/Cargo.lock
!/LICENSE*

# Global configuration formats
!*.toml
!*.yml
!*.yaml

# Root documentation & legal assets
!/README.md
!/CHANGELOG.md
!/CONTRIBUTING.md
!/CODE_OF_CONDUCT.md
!/SECURITY.md
!/TRADEMARK.md
!/LICENSE
!/LICENSE-CC-BY-4.0
!/cc.by.png
!/gplv3.webp

# Allowed project directory trees
!/docs/**
!/crates/**
!/common/**
!/apps/**
!/assets/**
!/scripts/**
!/tests/**
!/benches/**

# Exclude generated caches inside allowed subtrees
__pycache__/
**/.perihelion/